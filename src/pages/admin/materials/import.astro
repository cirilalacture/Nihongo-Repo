---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, materials, categories, jlptLevels } from '../../../db';
import { eq } from 'drizzle-orm';
import { ArrowLeft, Upload, FileSpreadsheet, CheckCircle2, AlertCircle, Download } from '@lucide/astro';

let errorMessage = '';
let successCount = 0;

const db = getDb();

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    let csvText = '';

    const csvFile = formData.get('csvFile') as File | null;
    const pastedCsv = (formData.get('csvText') || '').toString().trim();

    if (csvFile && csvFile.size > 0) {
      csvText = await csvFile.text();
    } else if (pastedCsv) {
      csvText = pastedCsv;
    }

    if (!csvText) {
      errorMessage = 'Silakan pilih berkas CSV atau tempel teks CSV!';
    } else if (db) {
      // Preload categories and levels maps
      const allCategories = await db.select().from(categories).all();
      const allLevels = await db.select().from(jlptLevels).all();

      const catMap = new Map(allCategories.map((c) => [c.slug.toLowerCase(), c.id]));
      const lvlMap = new Map(allLevels.map((l) => [l.code.toUpperCase(), l.id]));

      // Fallback IDs if mapping fails
      const defaultCatId = allCategories[0]?.id || 'cat_grammar';
      const defaultLvlId = allLevels[0]?.id || 'lvl_n5';

      // Parse CSV Lines (Basic CSV parser handling quoted cells)
      const lines = csvText.split(/\r?\n/).filter((l) => l.trim().length > 0);
      if (lines.length <= 1) {
        errorMessage = 'Berkas CSV kosong atau hanya memiliki header.';
      } else {
        const headerCells = lines[0].split(',').map((h) => h.replace(/^"|"$/g, '').trim());
        
        for (let i = 1; i < lines.length; i++) {
          const rawLine = lines[i];
          // Regex to parse comma separated values respecting quotes
          const match = rawLine.match(/(".*?"|[^",\s]+)(?=\s*,|\s*$)/g);
          const cells = (rawLine.match(/(".*?"|[^",]*)(,|$)/g) || [])
            .map((c) => c.replace(/,$/, '').replace(/^"|"$/g, '').replace(/""/g, '"').trim());

          const rowData: Record<string, string> = {};
          headerCells.forEach((header, idx) => {
            rowData[header] = cells[idx] || '';
          });

          const title = rowData.title || '';
          const driveUrl = rowData.driveUrl || '';

          if (title && driveUrl) {
            const categorySlug = (rowData.categorySlug || 'grammar').toLowerCase();
            const levelCode = (rowData.levelCode || 'ALL').toUpperCase();

            const categoryId = catMap.get(categorySlug) || defaultCatId;
            const levelId = lvlMap.get(levelCode) || defaultLvlId;

            let driveFileId: string | null = rowData.driveFileId || null;
            if (!driveFileId) {
              const match = driveUrl.match(/\/d\/([a-zA-Z0-9_-]+)/) || driveUrl.match(/id=([a-zA-Z0-9_-]+)/);
              if (match) driveFileId = match[1];
            }

            const newId = 'mat_import_' + Date.now().toString(36) + Math.random().toString(36).substring(2, 6);

            await db.insert(materials).values({
              id: newId,
              title,
              romajiTitle: rowData.romajiTitle || null,
              originalTitle: rowData.originalTitle || null,
              author: rowData.author || null,
              publisher: rowData.publisher || null,
              publishYear: parseInt(rowData.publishYear || '0', 10) || null,
              categoryId,
              levelId,
              driveUrl,
              driveFileId,
              coverImageUrl: rowData.coverImageUrl || null,
              fileType: rowData.fileType || 'PDF',
              fileSize: rowData.fileSize || null,
              isRecommended: rowData.isRecommended === '1' ? 1 : 0,
              isPublished: rowData.isPublished === '0' ? 0 : 1,
              description: rowData.description || null,
              clickCount: 0,
            });

            successCount++;
          }
        }

        if (successCount > 0) {
          return Astro.redirect(`/admin/materials?msg=Berhasil mengimpor ${successCount} materi baru dari CSV!`);
        } else {
          errorMessage = 'Tidak ada baris data valid yang berhasil diimpor. Pastikan kolom "title" dan "driveUrl" terisi.';
        }
      }
    }
  } catch (err) {
    console.error('Import CSV error:', err);
    errorMessage = 'Terjadi kesalahan saat memproses berkas CSV.';
  }
}
---

<AdminLayout title="Impor Materi dari CSV — Admin CMS" activeNav="materials">
  <div class="max-w-3xl space-y-6">
    
    <!-- Top Back Navigation -->
    <div>
      <a
        href="/admin/materials"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] transition-colors mb-3"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Kembali ke Daftar Materi</span>
      </a>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--color-ink-primary)]">
        Impor Koleksi Materi dari Berkas CSV
      </h2>
      <p class="text-xs text-[var(--color-ink-tertiary)] mt-0.5">
        Unggah berkas CSV atau tempel teks data buku untuk memasukkan banyak materi Google Drive sekaligus.
      </p>
    </div>

    {errorMessage && (
      <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-xs font-semibold text-red-700 animate-in fade-in">
        {errorMessage}
      </div>
    )}

    <!-- Form Container -->
    <form method="POST" enctype="multipart/form-data" class="bg-[var(--color-surface)] border border-[var(--color-border-washi)] rounded-2xl p-6 sm:p-8 shadow-2xs space-y-6">
      
      <!-- Option 1: File Upload -->
      <div>
        <label for="csvFile" class="block text-xs font-bold text-[var(--color-ink-primary)] mb-1.5">
          Pilih Berkas CSV (.csv)
        </label>
        <input
          type="file"
          id="csvFile"
          name="csvFile"
          accept=".csv,text/csv"
          class="w-full px-3.5 py-2.5 rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-canvas)] text-xs text-[var(--color-ink-primary)] focus:outline-none file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[var(--color-vermilion-subtle)] file:text-[var(--color-vermilion)] hover:file:bg-red-100 cursor-pointer"
        />
      </div>

      <div class="flex items-center gap-3">
        <div class="h-px flex-1 bg-[var(--color-border-washi)]"></div>
        <span class="text-[10px] font-bold text-[var(--color-ink-tertiary)] uppercase tracking-wider">Atau Tempel Teks CSV</span>
        <div class="h-px flex-1 bg-[var(--color-border-washi)]"></div>
      </div>

      <!-- Option 2: Paste Raw CSV -->
      <div>
        <label for="csvText" class="block text-xs font-bold text-[var(--color-ink-primary)] mb-1.5">
          Teks Data CSV
        </label>
        <textarea
          id="csvText"
          name="csvText"
          rows="6"
          placeholder="title,romajiTitle,categorySlug,levelCode,driveUrl,fileType,fileSize&#10;Minna no Nihongo 1,Minna no Nihongo 1,grammar,N5,https://drive.google.com/file/d/sample/view,PDF,45 MB"
          class="w-full px-3.5 py-2.5 rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-canvas)] text-xs font-mono focus:outline-none focus:border-[var(--color-vermilion)] leading-relaxed"
        ></textarea>
      </div>

      <!-- Format Guidelines & Sample -->
      <div class="p-4 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)] text-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-[var(--color-ink-primary)]">Format Kolom Header yang Didukung:</span>
          <a
            href="/api/admin/materials/export"
            class="inline-flex items-center gap-1 text-[11px] font-semibold text-[var(--color-vermilion)] hover:underline"
          >
            <Download class="w-3 h-3" />
            <span>Unduh Contoh Data CSV</span>
          </a>
        </div>
        <code class="block p-2 rounded-lg bg-[var(--color-canvas)] border border-[var(--color-border-washi)] text-[10px] text-[var(--color-ink-secondary)] overflow-x-auto whitespace-nowrap">
          title,romajiTitle,originalTitle,author,publisher,publishYear,categorySlug,levelCode,driveUrl,fileType,fileSize,description
        </code>
        <ul class="text-[11px] text-[var(--color-ink-tertiary)] list-disc pl-4 space-y-0.5">
          <li><strong>Kolom Wajib:</strong> <code>title</code> dan <code>driveUrl</code>.</li>
          <li><strong>categorySlug:</strong> <code>grammar</code>, <code>kanji</code>, <code>vocab</code>, <code>reading</code>, <code>listening</code>, <code>exam</code>.</li>
          <li><strong>levelCode:</strong> <code>N5</code>, <code>N4</code>, <code>N3</code>, <code>N2</code>, <code>N1</code>, <code>ALL</code>.</li>
        </ul>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-[var(--color-border-washi)] flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-3">
        <a
          href="/admin/materials"
          class="flex items-center justify-center px-5 py-3 min-h-[44px] rounded-xl border border-[var(--color-border-washi)] text-xs font-bold text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] active:scale-95 transition-all text-center"
        >
          Batal
        </a>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] rounded-xl bg-[var(--color-vermilion)] hover:bg-[var(--color-vermilion-hover)] text-white text-xs font-bold shadow-2xs transition-all active:scale-95"
        >
          <Upload class="w-4 h-4" />
          <span>Mulai Impor Data</span>
        </button>
      </div>

    </form>

  </div>
</AdminLayout>
