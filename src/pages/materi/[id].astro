---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getDb, materials, categories, jlptLevels } from '../../db';
import { eq, ne, and } from 'drizzle-orm';
import { ArrowLeft, ExternalLink, Copy, Share2, Eye, BookOpen, Layers, Star, Download, FolderDown, ArrowUpRight } from '@lucide/astro';

const { id } = Astro.params;
let materialItem: any = null;
let relatedMaterials: any[] = [];

const db = getDb();

if (db && id) {
  try {
    const rows = await db
      .select({
        id: materials.id,
        title: materials.title,
        romajiTitle: materials.romajiTitle,
        originalTitle: materials.originalTitle,
        author: materials.author,
        publisher: materials.publisher,
        publishYear: materials.publishYear,
        description: materials.description,
        driveUrl: materials.driveUrl,
        driveFileId: materials.driveFileId,
        coverImageUrl: materials.coverImageUrl,
        fileType: materials.fileType,
        fileSize: materials.fileSize,
        isRecommended: materials.isRecommended,
        clickCount: materials.clickCount,
        categoryName: categories.name,
        categorySlug: categories.slug,
        levelCode: jlptLevels.code,
        levelLabel: jlptLevels.label,
        badgeBg: jlptLevels.badgeBg,
        badgeText: jlptLevels.badgeText,
      })
      .from(materials)
      .leftJoin(categories, eq(materials.categoryId, categories.id))
      .leftJoin(jlptLevels, eq(materials.levelId, jlptLevels.id))
      .where(eq(materials.id, id))
      .limit(1)
      .all();

    if (rows.length > 0) {
      materialItem = rows[0];

      // Fetch related materials
      relatedMaterials = await db
        .select({
          id: materials.id,
          title: materials.title,
          levelCode: jlptLevels.code,
          categoryName: categories.name,
          badgeBg: jlptLevels.badgeBg,
          badgeText: jlptLevels.badgeText,
          driveUrl: materials.driveUrl,
        })
        .from(materials)
        .leftJoin(categories, eq(materials.categoryId, categories.id))
        .leftJoin(jlptLevels, eq(materials.levelId, jlptLevels.id))
        .where(ne(materials.id, id))
        .limit(3)
        .all();
    }
  } catch (err) {
    console.error('Error fetching material detail page:', err);
  }
}

// Fallback sample item if DB offline
if (!materialItem) {
  materialItem = {
    id: id || 'mat_sample',
    title: 'Minna no Nihongo Shokyu I (Second Edition)',
    romajiTitle: 'Minna no Nihongo Shokyu 1',
    originalTitle: 'みんなの日本語 初級I 第2版 本冊',
    author: '3A Corporation',
    publisher: '3A Corporation',
    publishYear: 2012,
    description: 'Buku teks standar utama pembelajaran bahasa Jepang tingkat pemula (Bab 1 - Bab 25). Memuat tata bahasa dasar, pola kalimat, percakapan sehari-hari, dan latihan komprehensif.',
    driveUrl: 'https://drive.google.com/file/d/sample1/view?usp=sharing',
    driveFileId: 'sample1',
    coverImageUrl: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80',
    fileType: 'PDF',
    fileSize: '48 MB',
    isRecommended: 1,
    clickCount: 342,
    categoryName: 'Tata Bahasa',
    categorySlug: 'grammar',
    levelCode: 'N5',
    levelLabel: 'N5 (Pemula)',
    badgeBg: '#ECFDF5',
    badgeText: '#065F46',
  };
}

const pageTitle = `${materialItem.title} (${materialItem.levelCode || 'JLPT'}) — Nihongo_repo`;
const pageDescription = materialItem.description || `Pelajari materi ${materialItem.title} untuk persiapan ujian JLPT ${materialItem.levelCode}. Berkas lengkap tersimpan di Google Drive.`;
const currentUrl = Astro.url.href;

let previewUrl = '';
if (materialItem.driveFileId) {
  previewUrl = `https://drive.google.com/file/d/${materialItem.driveFileId}/preview`;
} else if (materialItem.driveUrl) {
  previewUrl = materialItem.driveUrl.replace(/\/view(\?.*)?$/, '/preview');
}
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar slot="header" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    
    <!-- Breadcrumb & Back Link -->
    <div class="flex items-center justify-between gap-4 mb-6">
      <nav class="flex items-center gap-2 text-xs text-[var(--color-ink-tertiary)]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-vermilion)] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/#katalog" class="hover:text-[var(--color-vermilion)] transition-colors">{materialItem.categoryName || 'Katalog'}</a>
        <span>/</span>
        <span class="font-semibold text-[var(--color-ink-primary)] truncate max-w-[200px] sm:max-w-xs">{materialItem.title}</span>
      </nav>

      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] transition-colors shrink-0"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Katalog Lengkap</span>
      </a>
    </div>

    <!-- Main Hero Card -->
    <article class="bg-[var(--color-surface)] border border-[var(--color-border-washi)] rounded-3xl p-6 sm:p-8 shadow-sm space-y-8">
      
      <!-- Top Row: Cover Thumbnail + Main Metadata -->
      <div class="flex flex-col sm:flex-row items-start gap-6">
        
        <!-- Cover Art or Kanji Banner -->
        <div class="w-full sm:w-48 h-64 sm:h-64 rounded-2xl overflow-hidden bg-neutral-100 border border-[var(--color-border-washi)] flex items-center justify-center shrink-0 shadow-2xs">
          {materialItem.coverImageUrl ? (
            <img
              src={materialItem.coverImageUrl}
              alt={materialItem.title}
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
          ) : null}
          <div
            class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-red-50/60 via-neutral-100 to-amber-50/50 p-4 text-center"
            style={materialItem.coverImageUrl ? 'display: none;' : 'display: flex;'}
          >
            <div class="text-4xl font-bold font-japanese text-[var(--color-ink-primary)]/80 mb-2">
              {materialItem.originalTitle ? materialItem.originalTitle.slice(0, 4) : '日本語'}
            </div>
            <span class="text-xs text-[var(--color-ink-tertiary)] font-medium max-w-[140px] truncate">
              {materialItem.title}
            </span>
          </div>
        </div>

        <!-- Info Details -->
        <div class="flex-1 space-y-3.5 min-w-0">
          <!-- Level & Category Info (Clean typography) -->
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-bold text-[var(--color-ink-primary)] text-sm">
              {materialItem.levelCode || 'ALL'}
            </span>
            {materialItem.levelLabel && materialItem.levelCode !== 'ALL' && (
              <span class="text-[var(--color-ink-tertiary)]">
                {materialItem.levelLabel.replace(materialItem.levelCode, '').trim()}
              </span>
            )}
            <span class="text-[var(--color-ink-tertiary)] opacity-40">•</span>
            <span class="font-semibold text-[var(--color-vermilion)] uppercase tracking-wider">
              {materialItem.categoryName || 'Materi'}
            </span>
            {materialItem.isRecommended === 1 && (
              <div class="inline-flex items-center gap-1 font-semibold text-amber-600 dark:text-amber-400 ml-1">
                <span class="text-[var(--color-ink-tertiary)] opacity-40 mr-1">•</span>
                <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
                <span>Pilihan Sensei</span>
              </div>
            )}
          </div>

          <!-- Titles -->
          <div>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[var(--color-ink-primary)] tracking-tight leading-tight">
              {materialItem.title}
            </h1>
            {materialItem.originalTitle && (
              <p class="text-sm font-japanese text-[var(--color-ink-tertiary)] mt-1">
                {materialItem.originalTitle}
              </p>
            )}
            {materialItem.romajiTitle && materialItem.romajiTitle !== materialItem.title && (
              <p class="text-xs text-[var(--color-ink-tertiary)] italic mt-0.5">
                Romaji: {materialItem.romajiTitle}
              </p>
            )}
          </div>

          <!-- Specs Table -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2 text-xs">
            <div class="p-2.5 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
              <span class="text-[10px] text-[var(--color-ink-tertiary)] block">Pengarang</span>
              <span class="font-bold text-[var(--color-ink-primary)] block truncate">{materialItem.author || '-'}</span>
            </div>
            <div class="p-2.5 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
              <span class="text-[10px] text-[var(--color-ink-tertiary)] block">Penerbit</span>
              <span class="font-bold text-[var(--color-ink-primary)] block truncate">{materialItem.publisher || '-'}</span>
            </div>
            <div class="p-2.5 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
              <span class="text-[10px] text-[var(--color-ink-tertiary)] block">Tahun Terbit</span>
              <span class="font-bold text-[var(--color-ink-primary)] block">{materialItem.publishYear || '-'}</span>
            </div>
            <div class="p-2.5 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
              <span class="text-[10px] text-[var(--color-ink-tertiary)] block">Format & Ukuran</span>
              <span class="font-bold text-[var(--color-ink-primary)] block">{materialItem.fileType || 'PDF'} ({materialItem.fileSize || '-'})</span>
            </div>
          </div>

          <!-- Primary Actions -->
          <div class="pt-2 flex flex-wrap items-center gap-2.5">
            <a
              href={materialItem.driveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-2.5 min-h-[44px] rounded-xl bg-[var(--color-vermilion)] hover:bg-[var(--color-vermilion-hover)] text-white text-xs font-bold shadow-sm transition-all active:scale-95"
            >
              <span>Buka di Google Drive</span>
              <ExternalLink class="w-4 h-4" />
            </a>

            <button
              type="button"
              id="detail-share-btn"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 min-h-[44px] rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] hover:bg-[var(--color-surface-subtle)] text-xs font-semibold text-[var(--color-ink-secondary)] active:scale-95 transition-all"
            >
              <Share2 class="w-4 h-4" />
              <span id="share-btn-text">Bagikan</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Section: Description -->
      <div class="pt-6 border-t border-[var(--color-border-washi)] space-y-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-ink-tertiary)]">
          Tentang Materi Ini
        </h2>
        <p class="text-sm text-[var(--color-ink-secondary)] leading-relaxed bg-[var(--color-canvas)] p-5 rounded-2xl border border-[var(--color-border-washi)]">
          {materialItem.description || 'Tidak ada deskripsi rinci untuk buku ini.'}
        </p>
      </div>

      <!-- Section: Document Viewer Embed Preview -->
      <div class="pt-6 border-t border-[var(--color-border-washi)] space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-ink-tertiary)] flex items-center gap-2">
            <Eye class="w-4 h-4 text-[var(--color-vermilion)]" />
            <span>Pratinjau Dokumen Google Drive</span>
          </h2>
          <span class="text-[11px] text-[var(--color-ink-tertiary)] hidden sm:inline">Preview Mode</span>
        </div>

        <div class="relative w-full h-[480px] sm:h-[580px] rounded-2xl overflow-hidden border border-[var(--color-border-washi)] bg-neutral-100 shadow-inner">
          <iframe
            src={previewUrl}
            class="w-full h-full border-0"
            loading="lazy"
            allow="autoplay"
          ></iframe>
        </div>
      </div>

    </article>

    <!-- Related Materials -->
    {relatedMaterials.length > 0 && (
      <div class="mt-10 space-y-4">
        <h3 class="text-base font-bold text-[var(--color-ink-primary)]">
          Materi Terkait Lainnya
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedMaterials.map((rel) => (
            <a
              href={`/materi/${rel.id}`}
              class="p-4 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border-washi)] hover:border-neutral-400 transition-all shadow-2xs group flex flex-col justify-between"
            >
              <div>
                <span class="text-xs font-bold text-[var(--color-ink-primary)] mb-1 block">
                  {rel.levelCode || 'ALL'}
                </span>
                <h4 class="text-xs font-bold text-[var(--color-ink-primary)] group-hover:text-[var(--color-vermilion)] transition-colors line-clamp-2">
                  {rel.title}
                </h4>
              </div>
              <span class="text-[11px] text-[var(--color-ink-tertiary)] mt-3 flex items-center gap-1 font-semibold">
                <span>Lihat Detail</span>
                <ArrowUpRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
              </span>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function () {
    const shareBtn = document.getElementById('detail-share-btn');
    const shareText = document.getElementById('share-btn-text');
    if (!shareBtn) return;

    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            text: 'Pelajari materi ini di Nihongo_repo:',
            url: window.location.href,
          });
          return;
        } catch (err) {
          // Fallback to clipboard
        }
      }

      navigator.clipboard.writeText(window.location.href).then(() => {
        if (shareText) shareText.textContent = 'Link Disalin!';
        setTimeout(() => {
          if (shareText) shareText.textContent = 'Bagikan';
        }, 2000);
      });
    });
  })();
</script>
