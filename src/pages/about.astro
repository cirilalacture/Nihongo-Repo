---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  User,
  Heart,
  Sparkles,
  Code2,
  Globe,
  Mail,
  ArrowLeft,
  ArrowUpRight,
  ShieldCheck,
  BookOpen,
  MapPin,
  Award,
  Layers,
  Terminal,
} from '@lucide/astro';

// Creator Profile Data
const creatorProfile = {
  name: 'Jo',
  japaneseName: 'ジョ',
  role: 'Inisiator & Penggiat Bahasa Jepang',
  location: 'Tokyo, Japan & Solo, Indonesia',
  jlptLevel: 'JLPT N3',
  avatarUrl: '/avatar/1.webp',
  bio: 'Seorang pembelajar bahasa Jepang mandiri yang mendirikan Nihongo_repo untuk mempermudah akses buku teks, kanji, tata bahasa, dan audio persiapan JLPT secara cuma-cuma dan tertata rapi.',
  githubUrl: 'https://github.com/cirilalacture',
  repositoryUrl: 'https://github.com/cirilalacture/Nihongo-Repo',
  email: 'contact@ciril.dev',
};

// 7 Variasi pose karakter avatar interaktif (WebP optimized)
const avatarPoses = [
  '/avatar/1.webp',
  '/avatar/2.webp',
  '/avatar/3.webp',
  '/avatar/4.webp',
  '/avatar/5.webp',
  '/avatar/6.webp',
  '/avatar/7.webp',
];
---

<BaseLayout
  title="Tentang Pembuat — Nihongo_repo (日本語レポ)"
  description="Mengenal sosok di balik inisiatif katalog kurasi materi belajar dan bank soal bahasa Jepang Nihongo_repo."
>
  <Navbar slot="header" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    
    <!-- Breadcrumb & Back Link -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--color-ink-tertiary)]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-vermilion)] transition-colors">Beranda</a>
        <span>/</span>
        <span class="font-semibold text-[var(--color-ink-primary)]">Tentang Pembuat</span>
      </nav>

      <a
        href="/#katalog"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] transition-colors shrink-0"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Katalog Materi</span>
      </a>
    </div>

    <!-- Main Profile Card -->
    <article class="bg-[var(--color-surface)] border border-[var(--color-border-washi)] rounded-3xl p-6 sm:p-10 shadow-sm relative overflow-hidden mb-10">
      
      <!-- Subtle Japanese Watermark in Background -->
      <div class="absolute -right-6 -bottom-8 pointer-events-none select-none opacity-[0.03] text-[180px] font-japanese font-bold text-[var(--color-ink-primary)] leading-none -z-0">
        創作者
      </div>

      <!-- Top Row: Avatar Character (Borderless & Free-Standing) + Main Headline Details -->
      <div class="relative z-10 flex flex-col sm:flex-row items-center sm:items-center gap-6 sm:gap-10 pb-8 border-b border-[var(--color-border-washi)] text-center sm:text-left">
        
        <!-- Interactive Character Avatar Wrapper (Borderless Character Standing Naturally in Page) -->
        <div class="flex flex-col items-center shrink-0">
          <div class="relative">
            <button
              id="avatar-pose-btn"
              type="button"
              class="group relative block cursor-pointer select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-vermilion)] rounded-3xl transition-all text-left"
              title="Klik karakter untuk mengganti pose!"
              aria-label="Ganti pose karakter avatar (Klik atau tekan Enter)"
            >
              <!-- Pose Indicator Pill Badge -->
              <div
                id="avatar-pose-badge"
                class="absolute -top-3 -right-2 sm:-right-3 z-20 px-2.5 py-1 rounded-full bg-[var(--color-surface)]/95 backdrop-blur-xs dark:bg-neutral-800/95 border border-[var(--color-border-washi)] shadow-sm text-[11px] font-bold text-[var(--color-ink-secondary)] group-hover:text-[var(--color-vermilion)] group-hover:border-red-300 transition-all flex items-center gap-1.5"
              >
                <Sparkles class="w-3.5 h-3.5 text-[var(--color-vermilion)] animate-pulse" />
                <span id="avatar-pose-label">Pose 1/7</span>
              </div>

              <!-- Character Container without enclosing box (Free Standing Character) -->
              <div class="relative w-48 h-56 sm:w-60 sm:h-72 flex items-end justify-center group-hover:-translate-y-1.5 transition-transform duration-300 ease-out">
                <img
                  id="avatar-image"
                  src={avatarPoses[0]}
                  alt={creatorProfile.name}
                  width="240"
                  height="288"
                  decoding="async"
                  class="w-full h-full object-contain object-bottom filter drop-shadow-md group-hover:drop-shadow-xl transition-all duration-200 ease-out"
                  loading="eager"
                  data-pose-index="0"
                />
              </div>

              <!-- Soft Contact Shadow at Character's Base -->
              <div class="w-32 sm:w-40 h-2.5 bg-neutral-900/10 dark:bg-black/40 rounded-full blur-[3px] mx-auto -mt-1 group-hover:scale-90 group-hover:opacity-60 transition-all duration-300 pointer-events-none"></div>

              <!-- Red Stamp Seal Badge (Hanko Artist Seal) -->
              <div
                class="absolute bottom-2 -left-2 sm:-left-3 w-8 h-8 rounded-xl bg-[var(--color-vermilion)] text-white flex items-center justify-center font-bold text-xs shadow-md border-2 border-[var(--color-surface)] -rotate-6 group-hover:rotate-0 transition-transform duration-300"
                title="Sensei & Pembuat"
              >
                日
              </div>
            </button>
          </div>

          <!-- Helper Caption below Character -->
          <span class="text-[11px] font-medium text-[var(--color-ink-tertiary)] mt-2.5 flex items-center gap-1.5 select-none group-hover:text-[var(--color-vermilion)] transition-colors">
            <span class="text-xs">✨</span>
            <span>Otomatis berganti tiap 5s • Klik untuk ganti pose</span>
          </span>
        </div>

        <!-- Name, Role & Pills -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-center sm:justify-start gap-2 mb-2 text-xs font-semibold">
            <span class="text-[var(--color-vermilion)]">Sensei & Author</span>
            <span class="text-[var(--color-ink-tertiary)] opacity-40">•</span>
            <span class="font-japanese text-[var(--color-ink-secondary)]">{creatorProfile.japaneseName}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-ink-primary)] tracking-tight mb-1.5">
            {creatorProfile.name}
          </h1>

          <p class="text-xs sm:text-sm text-[var(--color-ink-secondary)] font-medium mb-4">
            {creatorProfile.role}
          </p>

          <!-- Badges Grid -->
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5 text-xs text-[var(--color-ink-tertiary)]">
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-border-washi)]">
              <MapPin class="w-3.5 h-3.5 text-[var(--color-vermilion)]" />
              <span>{creatorProfile.location}</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-border-washi)]">
              <Award class="w-3.5 h-3.5 text-amber-500" />
              <span>{creatorProfile.jlptLevel}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bio / Narrative Story -->
      <div class="relative z-10 pt-8 space-y-6 text-sm text-[var(--color-ink-secondary)] leading-relaxed">
        <div>
          <h2 class="text-base font-bold text-[var(--color-ink-primary)] tracking-tight mb-3 flex items-center gap-2">
            <Sparkles class="w-4 h-4 text-[var(--color-vermilion)]" />
            <span>Cerita di Balik Nihongo_repo</span>
          </h2>
          <p class="text-xs sm:text-sm text-[var(--color-ink-secondary)] leading-relaxed">
            {creatorProfile.bio}
          </p>
        </div>

        <div class="p-4 sm:p-5 rounded-2xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)] space-y-3">
          <h3 class="text-xs sm:text-sm font-bold text-[var(--color-ink-primary)]">
            Mengapa Proyek Ini Lahir?
          </h3>
          <p class="text-xs text-[var(--color-ink-tertiary)] leading-relaxed">
            Sebagai sesama pembelajar bahasa Jepang, salah satu rintangan terbesar di awal bukanlah susahnya kanji atau tata bahasa, melainkan <strong>berantakannya sumber belajar</strong>. Banyak tautan Google Drive yang mati di tengah jalan, berkas yang tidak terorganisir levelnya, atau situs download yang dipenuhi iklan pop-up dan shortlink yang merepotkan.
          </p>
          <p class="text-xs text-[var(--color-ink-tertiary)] leading-relaxed">
            Nihongo_repo hadir sebagai <em>safe haven</em>: sebuah direktori kurasi yang bersih, terstruktur rapi dari level N5 hingga N1, dan bebas dari iklan yang mengganggu agar siapa saja dapat fokus belajar dengan tenang.
          </p>
        </div>

        <!-- Vision & Commitments Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-2">
          <div class="p-4 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-border-washi)]">
            <div class="w-7 h-7 rounded-lg bg-red-50 text-[var(--color-vermilion)] flex items-center justify-center mb-2.5">
              <Heart class="w-4 h-4" />
            </div>
            <h4 class="text-xs font-bold text-[var(--color-ink-primary)] mb-1">100% Bebas Akses</h4>
            <p class="text-[11px] text-[var(--color-ink-tertiary)] leading-relaxed">
              Materi dapat diakses langsung tanpa biaya langganan atau registrasi wajib.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-border-washi)]">
            <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2.5">
              <ShieldCheck class="w-4 h-4" />
            </div>
            <h4 class="text-xs font-bold text-[var(--color-ink-primary)] mb-1">Terkurasi & Standar</h4>
            <p class="text-[11px] text-[var(--color-ink-tertiary)] leading-relaxed">
              Setiap buku dipilih berdasarkan reputasi resmi kurikulum ujian JLPT di Jepang.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-border-washi)]">
            <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-2.5">
              <Sparkles class="w-4 h-4" />
            </div>
            <h4 class="text-xs font-bold text-[var(--color-ink-primary)] mb-1">Rapi & Tanpa Iklan</h4>
            <p class="text-[11px] text-[var(--color-ink-tertiary)] leading-relaxed">
              Koleksi bersih tanpa iklan mengganggu, pop-up, atau shortlink yang membingungkan pembaca.
            </p>
          </div>
        </div>

        <!-- Action / Connect Row -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-t border-[var(--color-border-washi)]">
          <div class="flex items-center gap-2">
            <a
              href={creatorProfile.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 min-h-[42px] rounded-xl bg-[var(--color-ink-primary)] hover:opacity-90 text-[var(--color-canvas)] text-xs font-semibold shadow-2xs transition-all active:scale-95"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>Profil GitHub</span>
              <ArrowUpRight class="w-3.5 h-3.5 opacity-70" />
            </a>

            <a
              href={creatorProfile.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 min-h-[42px] rounded-xl bg-[var(--color-surface-subtle)] hover:bg-neutral-200/60 text-[var(--color-ink-primary)] text-xs font-semibold border border-[var(--color-border-washi)] transition-all active:scale-95"
            >
              <Terminal class="w-4 h-4 text-[var(--color-ink-tertiary)]" />
              <span>Source Code Repo</span>
            </a>
          </div>

          <a
            href={`mailto:${creatorProfile.email}`}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 min-h-[42px] rounded-xl text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] transition-colors"
          >
            <Mail class="w-4 h-4" />
            <span>{creatorProfile.email}</span>
          </a>
        </div>

      </div>
    </article>

  </div>

  <Footer slot="footer" />

  <script>
    const poses = [
      '/avatar/1.webp',
      '/avatar/2.webp',
      '/avatar/3.webp',
      '/avatar/4.webp',
      '/avatar/5.webp',
      '/avatar/6.webp',
      '/avatar/7.webp',
    ];

    function initAvatarPose() {
      const btn = document.getElementById('avatar-pose-btn');
      const img = document.getElementById('avatar-image') as HTMLImageElement | null;
      const label = document.getElementById('avatar-pose-label');

      if (!btn || !img || !label) return;

      // Preload all poses into browser memory for zero-lag instant switching
      poses.forEach((src) => {
        const pImg = new Image();
        pImg.src = src;
      });

      let currentIndex = 0;
      let autoRotateTimer: ReturnType<typeof setInterval> | null = null;

      function changePose() {
        if (!img || !label) return;
        currentIndex = (currentIndex + 1) % poses.length;

        // Lively character hop/bounce transition effect
        img.style.transform = 'scale(0.92) translateY(6px)';
        img.style.opacity = '0.75';

        setTimeout(() => {
          img.src = poses[currentIndex];
          img.setAttribute('data-pose-index', currentIndex.toString());
          label.textContent = `Pose ${currentIndex + 1}/${poses.length}`;

          img.style.transform = 'scale(1.05) translateY(-4px)';
          img.style.opacity = '1';

          setTimeout(() => {
            img.style.transform = '';
          }, 150);
        }, 75);
      }

      function startAutoRotate() {
        stopAutoRotate();
        autoRotateTimer = setInterval(() => {
          if (document.visibilityState !== 'hidden') {
            changePose();
          }
        }, 5000);
      }

      function stopAutoRotate() {
        if (autoRotateTimer) {
          clearInterval(autoRotateTimer);
          autoRotateTimer = null;
        }
      }

      btn.addEventListener('click', () => {
        changePose();
        // Reset 5s timer on manual click
        startAutoRotate();
      });

      // Start automatic rotation every 5 seconds
      startAutoRotate();

      // Pause when tab is hidden to conserve resources
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopAutoRotate();
        } else {
          startAutoRotate();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAvatarPose);
    } else {
      initAvatarPose();
    }
  </script>
</BaseLayout>
