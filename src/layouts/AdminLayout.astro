---
import '../styles/global.css';
import { LayoutDashboard, BookOpen, PlusCircle, Layers, Globe, LogOut, ShieldCheck, CheckCircle2, AlertCircle, KeyRound, Inbox } from '@lucide/astro';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'materials' | 'new-material' | 'categories' | 'requests' | 'settings';
}

const { title = 'Admin Dashboard — Nihongo_repo', activeNav = 'dashboard' } = Astro.props;
const currentUrl = Astro.url.pathname;
const urlParams = Astro.url.searchParams;
const successMsg = urlParams.get('msg');
const errorMsg = urlParams.get('err');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Theme Initialization Script -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('nihongo_theme');
          const isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-neutral-50 text-[var(--color-ink-primary)] min-h-screen flex antialiased font-sans">
    
    <!-- Sidebar Desktop -->
    <aside class="w-64 bg-[var(--color-surface)] border-r border-[var(--color-border-washi)] flex flex-col justify-between shrink-0 hidden md:flex sticky top-0 h-screen">
      <div>
        <!-- Admin Brand Header -->
        <div class="h-16 px-6 border-b border-[var(--color-border-washi)] flex items-center justify-between">
          <a href="/admin" class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-[var(--color-vermilion)] text-white flex items-center justify-center font-bold text-sm shadow-sm">
              日
            </div>
            <div>
              <span class="font-bold text-sm tracking-tight text-[var(--color-ink-primary)]">Admin CMS</span>
              <span class="text-[10px] text-[var(--color-ink-tertiary)] block">Nihongo_repo</span>
            </div>
          </a>
        </div>

        <!-- Navigation Menu -->
        <nav class="p-4 space-y-1 text-xs font-semibold">
          <div class="text-[10px] uppercase tracking-wider text-[var(--color-ink-tertiary)] px-3 py-2 font-bold">
            Menu Utama
          </div>

          <a
            href="/admin"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'dashboard'
                ? 'bg-[var(--color-vermilion-subtle)] text-[var(--color-vermilion)] font-bold'
                : 'text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)]'
            }`}
          >
            <LayoutDashboard class="w-4 h-4" />
            <span>Ringkasan Metrik</span>
          </a>

          <a
            href="/admin/materials"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'materials'
                ? 'bg-[var(--color-vermilion-subtle)] text-[var(--color-vermilion)] font-bold'
                : 'text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)]'
            }`}
          >
            <BookOpen class="w-4 h-4" />
            <span>Kelola Materi & Buku</span>
          </a>

          <a
            href="/admin/materials/new"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'new-material'
                ? 'bg-[var(--color-vermilion-subtle)] text-[var(--color-vermilion)] font-bold'
                : 'text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)]'
            }`}
          >
            <PlusCircle class="w-4 h-4" />
            <span>Tambah Buku Baru</span>
          </a>

          <a
            href="/admin/categories"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'categories'
                ? 'bg-[var(--color-vermilion-subtle)] text-[var(--color-vermilion)] font-bold'
                : 'text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)]'
            }`}
          >
            <Layers class="w-4 h-4" />
            <span>Kelola Kategori</span>
          </a>

          <a
            href="/admin/requests"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'requests'
                ? 'bg-[var(--color-vermilion-subtle)] text-[var(--color-vermilion)] font-bold'
                : 'text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)]'
            }`}
          >
            <Inbox class="w-4 h-4" />
            <span>Permintaan & Laporan</span>
          </a>

          <a
            href="/admin/settings"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
              activeNav === 'settings'
                ? 'bg-[var(--color-vermilion-subtle)] text-[var(--color-vermilion)] font-bold'
                : 'text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)]'
            }`}
          >
            <KeyRound class="w-4 h-4" />
            <span>Pengaturan Akun</span>
          </a>

          <div class="pt-4 text-[10px] uppercase tracking-wider text-[var(--color-ink-tertiary)] px-3 py-2 font-bold">
            Akses Publik
          </div>

          <a
            href="/"
            target="_blank"
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-[var(--color-ink-secondary)] hover:bg-[var(--color-surface-subtle)] hover:text-[var(--color-ink-primary)] transition-all"
          >
            <Globe class="w-4 h-4" />
            <span>Lihat Website</span>
          </a>
        </nav>
      </div>

      <!-- Admin User Footnote & Logout -->
      <div class="p-4 border-t border-[var(--color-border-washi)]">
        <div class="flex items-center justify-between gap-2 p-2 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <div class="flex items-center gap-2 overflow-hidden">
            <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xs shrink-0">
              <ShieldCheck class="w-4 h-4" />
            </div>
            <div class="truncate text-xs">
              <span class="font-bold text-[var(--color-ink-primary)] block truncate">Sensei Admin</span>
              <span class="text-[10px] text-[var(--color-ink-tertiary)]">Superadmin</span>
            </div>
          </div>
          <a
            href="/admin/logout"
            class="p-1.5 rounded-lg text-neutral-400 hover:text-red-600 hover:bg-red-50 transition-colors"
            title="Keluar / Logout"
          >
            <LogOut class="w-4 h-4" />
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      
      <!-- Topbar Header -->
      <header class="h-16 px-4 sm:px-8 bg-[var(--color-surface)] border-b border-[var(--color-border-washi)] flex items-center justify-between gap-4 sticky top-0 z-30">
        <div class="flex items-center gap-3">
          <!-- Mobile Brand -->
          <a href="/admin" class="md:hidden flex items-center gap-2 group">
            <div class="w-8 h-8 rounded-lg bg-[var(--color-vermilion)] text-white flex items-center justify-center font-bold text-xs shadow-sm">
              日
            </div>
            <div>
              <span class="font-bold text-sm tracking-tight text-[var(--color-ink-primary)] block leading-none">Admin CMS</span>
              <span class="text-[9px] text-[var(--color-ink-tertiary)] font-medium">Nihongo_repo</span>
            </div>
          </a>
          <!-- Desktop Title -->
          <h1 class="hidden md:block font-bold text-base text-[var(--color-ink-primary)]">
            {title.split('—')[0]}
          </h1>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <!-- View Live Website Link -->
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--color-border-washi)] bg-[var(--color-surface-subtle)] hover:bg-neutral-200 text-xs font-semibold text-[var(--color-ink-secondary)] transition-colors"
            title="Lihat Website Publik"
          >
            <Globe class="w-3.5 h-3.5 text-[var(--color-ink-tertiary)]" />
            <span class="hidden sm:inline">Lihat Web</span>
          </a>

          <!-- Quick Action (Desktop & Tablet) -->
          <a
            href="/admin/materials/new"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--color-vermilion)] hover:bg-[var(--color-vermilion-hover)] text-white text-xs font-semibold shadow-2xs transition-all active:scale-95"
          >
            <PlusCircle class="w-3.5 h-3.5" />
            <span>Tambah Materi</span>
          </a>

          <!-- Logout Button (Mobile) -->
          <a
            href="/admin/logout"
            class="md:hidden p-2 min-w-[38px] min-h-[38px] flex items-center justify-center rounded-lg text-neutral-500 hover:text-red-600 hover:bg-red-50 transition-colors"
            title="Keluar / Logout"
            aria-label="Logout"
          >
            <LogOut class="w-4 h-4" />
          </a>
        </div>
      </header>

      <!-- Alert Notification Banner (If query param msg or err exists) -->
      {successMsg && (
        <div class="mx-4 sm:mx-8 mt-4 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs font-medium text-emerald-800 flex items-center gap-2 animate-in fade-in">
          <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
          <span>{successMsg}</span>
        </div>
      )}

      {errorMsg && (
        <div class="mx-4 sm:mx-8 mt-4 p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs font-medium text-red-800 flex items-center gap-2 animate-in fade-in">
          <AlertCircle class="w-4 h-4 text-red-600 shrink-0" />
          <span>{errorMsg}</span>
        </div>
      )}

      <!-- Page Content Stage (Extra bottom padding on mobile for sticky nav) -->
      <main class="p-4 sm:p-8 pb-28 md:pb-8 flex-1">
        <slot />
      </main>

      <!-- Mobile / Tablet Sticky Bottom Navigation Bar -->
      <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-[var(--color-surface)]/95 backdrop-blur-md border-t border-[var(--color-border-washi)] shadow-lg px-2 py-1.5 pb-[max(0.375rem,env(safe-area-inset-bottom))] flex items-center justify-around">
        <a
          href="/admin"
          class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl min-w-[64px] min-h-[48px] transition-all ${
            activeNav === 'dashboard'
              ? 'text-[var(--color-vermilion)] font-bold'
              : 'text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)]'
          }`}
        >
          <LayoutDashboard class={`w-5 h-5 mb-0.5 ${activeNav === 'dashboard' ? 'stroke-[2.5]' : ''}`} />
          <span class="text-[10px]">Ringkasan</span>
        </a>

        <a
          href="/admin/materials"
          class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl min-w-[64px] min-h-[48px] transition-all ${
            activeNav === 'materials'
              ? 'text-[var(--color-vermilion)] font-bold'
              : 'text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)]'
          }`}
        >
          <BookOpen class={`w-5 h-5 mb-0.5 ${activeNav === 'materials' ? 'stroke-[2.5]' : ''}`} />
          <span class="text-[10px]">Materi</span>
        </a>

        <a
          href="/admin/materials/new"
          class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl min-w-[64px] min-h-[48px] transition-all ${
            activeNav === 'new-material'
              ? 'text-[var(--color-vermilion)] font-bold'
              : 'text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)]'
          }`}
        >
          <div class={`w-7 h-7 rounded-full flex items-center justify-center mb-0.5 ${activeNav === 'new-material' ? 'bg-[var(--color-vermilion)] text-white shadow-xs' : 'bg-neutral-100 text-[var(--color-ink-secondary)]'}`}>
            <PlusCircle class="w-4 h-4" />
          </div>
          <span class="text-[10px]">Tambah</span>
        </a>

        <a
          href="/admin/categories"
          class={`flex flex-col items-center justify-center py-1 px-2 rounded-xl min-w-[50px] min-h-[48px] transition-all ${
            activeNav === 'categories'
              ? 'text-[var(--color-vermilion)] font-bold'
              : 'text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)]'
          }`}
        >
          <Layers class={`w-5 h-5 mb-0.5 ${activeNav === 'categories' ? 'stroke-[2.5]' : ''}`} />
          <span class="text-[10px]">Kategori</span>
        </a>

        <a
          href="/admin/requests"
          class={`flex flex-col items-center justify-center py-1 px-2 rounded-xl min-w-[50px] min-h-[48px] transition-all ${
            activeNav === 'requests'
              ? 'text-[var(--color-vermilion)] font-bold'
              : 'text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)]'
          }`}
        >
          <Inbox class={`w-5 h-5 mb-0.5 ${activeNav === 'requests' ? 'stroke-[2.5]' : ''}`} />
          <span class="text-[10px]">Laporan</span>
        </a>

        <a
          href="/admin/settings"
          class={`flex flex-col items-center justify-center py-1 px-2.5 rounded-xl min-w-[56px] min-h-[48px] transition-all ${
            activeNav === 'settings'
              ? 'text-[var(--color-vermilion)] font-bold'
              : 'text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)]'
          }`}
        >
          <KeyRound class={`w-5 h-5 mb-0.5 ${activeNav === 'settings' ? 'stroke-[2.5]' : ''}`} />
          <span class="text-[10px]">Akun</span>
        </a>
      </nav>

    </div>

  </body>
</html>
