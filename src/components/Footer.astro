---
import { Lock, Heart, Globe, Github } from '@lucide/astro';
---

<footer class="border-t border-[var(--color-border-washi)] bg-[var(--color-surface)] py-12 text-sm text-[var(--color-ink-secondary)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-md bg-[var(--color-vermilion)] text-white flex items-center justify-center font-bold text-sm">
            日
          </div>
          <span class="font-bold text-base text-[var(--color-ink-primary)]">
            Nihongo_repo (日本語レポ)
          </span>
        </div>
        <p class="text-xs text-[var(--color-ink-tertiary)] max-w-sm leading-relaxed">
          Katalog kurasi materi dan buku bahasa Jepang terstruktur dari N5 hingga N1. Seluruh berkas tersimpan aman di Google Drive untuk mempermudah akses belajar mandiri.
        </p>
        <div class="flex items-center gap-2 pt-1 text-xs">
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)] text-[11px] font-mono text-[var(--color-ink-tertiary)]">
            Cloudflare D1 & Pages
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)] text-[11px] font-mono text-[var(--color-ink-tertiary)]">
            Astro v7
          </span>
        </div>
      </div>

      <!-- Quick Nav JLPT -->
      <div>
        <h4 class="text-xs font-bold text-[var(--color-ink-primary)] uppercase tracking-wider mb-3">
          Tingkat JLPT
        </h4>
        <ul class="space-y-1 text-xs text-[var(--color-ink-secondary)]">
          <li><a href="/#jlpt-filter" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">JLPT N5 (Dasar)</a></li>
          <li><a href="/#jlpt-filter" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">JLPT N4 (Dasar Lanjutan)</a></li>
          <li><a href="/#jlpt-filter" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">JLPT N3 (Menengah)</a></li>
          <li><a href="/#jlpt-filter" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">JLPT N2 (Pra-Mahir)</a></li>
          <li><a href="/#jlpt-filter" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">JLPT N1 (Tingkat Mahir)</a></li>
        </ul>
      </div>

      <!-- Administration & Links -->
      <div>
        <h4 class="text-xs font-bold text-[var(--color-ink-primary)] uppercase tracking-wider mb-3">
          Kelola & Akses
        </h4>
        <ul class="space-y-1 text-xs text-[var(--color-ink-secondary)]">
          <li>
            <a href="/admin" class="inline-flex items-center gap-1.5 py-1 hover:text-[var(--color-vermilion)] transition-colors">
              <Lock class="w-3.5 h-3.5 text-[var(--color-ink-tertiary)]" />
              <span>Admin Dashboard</span>
            </a>
          </li>
          <li>
            <a href="/admin/materials/new" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">
              Tambah Buku Baru
            </a>
          </li>
          <li>
            <a href="/#pencarian" class="inline-block py-1 hover:text-[var(--color-vermilion)] transition-colors">
              Pencarian Cepat
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 border-t border-[var(--color-border-washi)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--color-ink-tertiary)]">
      <div>
        © 2026 Nihongo_repo. Dibuat untuk komunitas pembelajar bahasa Jepang.
      </div>
      <div class="flex items-center gap-1">
        <span>Semoga sukses lulus JLPT!</span>
        <span class="font-japanese font-semibold text-[var(--color-ink-secondary)]">がんばってください！</span>
      </div>
    </div>
  </div>
</footer>
