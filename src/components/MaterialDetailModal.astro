---
import { X, ExternalLink, Copy, Check, BookOpen, Eye, ArrowUpRight, FileText } from '@lucide/astro';
---

<div
  id="detail-modal"
  class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center p-0 sm:p-6 bg-black/60 backdrop-blur-xs transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Modal Card (Bottom Sheet on Mobile, Centered Card on Tablet/Desktop) -->
  <div class="relative w-full max-w-lg bg-[var(--color-surface)] border border-[var(--color-border-washi)] rounded-t-3xl sm:rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[88vh] sm:max-h-[90vh] animate-in slide-in-from-bottom sm:zoom-in-95 duration-200">
    
    <!-- Mobile Grab Handle Indicator -->
    <div class="w-12 h-1.5 bg-neutral-300 rounded-full mx-auto mt-3 mb-1 sm:hidden"></div>

    <!-- Modal Header -->
    <div class="px-5 sm:px-6 pt-3 sm:pt-6 pb-3 border-b border-[var(--color-border-washi)] flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2 mb-1.5 text-xs">
          <span id="modal-level-badge" class="font-bold text-[var(--color-ink-primary)]">
            N5
          </span>
          <span class="text-[var(--color-ink-tertiary)] opacity-40">•</span>
          <span id="modal-category-name" class="font-semibold text-[var(--color-vermilion)] uppercase tracking-wider">
            Tata Bahasa
          </span>
        </div>
        <h2 id="modal-title" class="text-lg sm:text-xl font-bold text-[var(--color-ink-primary)] leading-snug break-words">
          Judul Buku
        </h2>
        <p id="modal-original-title" class="text-xs font-japanese text-[var(--color-ink-tertiary)] mt-0.5 truncate">
          みんなの日本語
        </p>
      </div>

      <!-- Close Button (Touch Friendly) -->
      <button
        type="button"
        id="modal-close-btn"
        class="p-2 min-w-[40px] min-h-[40px] flex items-center justify-center rounded-xl text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)] hover:bg-[var(--color-surface-subtle)] active:scale-95 transition-all shrink-0"
        aria-label="Tutup Detail"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- Tabs Header: Info vs Preview -->
    <div class="px-5 sm:px-6 pt-1 pb-0 flex items-center gap-4 border-b border-[var(--color-border-washi)] bg-[var(--color-surface-subtle)] text-xs font-semibold">
      <button
        type="button"
        id="modal-tab-info"
        class="modal-tab-btn py-2.5 border-b-2 border-[var(--color-vermilion)] text-[var(--color-vermilion)] font-bold flex items-center gap-1.5 transition-all"
      >
        <BookOpen class="w-3.5 h-3.5" />
        <span>Ringkasan & Detail</span>
      </button>
      <button
        type="button"
        id="modal-tab-preview"
        class="modal-tab-btn py-2.5 border-b-2 border-transparent text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)] flex items-center gap-1.5 transition-all"
      >
        <Eye class="w-3.5 h-3.5" />
        <span>Intip Isi Buku (PDF Preview)</span>
      </button>
    </div>

    <!-- Modal Body: Tab 1 - Info -->
    <div id="modal-content-info" class="p-5 sm:p-6 overflow-y-auto space-y-4 sm:space-y-5 text-sm overscroll-contain">
      <!-- Description -->
      <div>
        <h3 class="text-xs font-bold text-[var(--color-ink-tertiary)] uppercase tracking-wider mb-2">
          Deskripsi Materi
        </h3>
        <p id="modal-description" class="text-xs sm:text-sm text-[var(--color-ink-secondary)] leading-relaxed bg-[var(--color-canvas)] p-3.5 rounded-xl border border-[var(--color-border-washi)] break-words">
          Deskripsi lengkap materi akan tampil di sini.
        </p>
      </div>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-2 gap-2.5 sm:gap-3 text-xs">
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Pengarang</span>
          <span id="modal-author" class="font-semibold text-[var(--color-ink-primary)] block truncate">3A Corporation</span>
        </div>
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Penerbit</span>
          <span id="modal-publisher" class="font-semibold text-[var(--color-ink-primary)] block truncate">3A Corporation</span>
        </div>
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Tahun Terbit</span>
          <span id="modal-year" class="font-semibold text-[var(--color-ink-primary)] block">2012</span>
        </div>
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Format & Ukuran</span>
          <span id="modal-size" class="font-semibold text-[var(--color-ink-primary)] block">PDF (48 MB)</span>
        </div>
      </div>
    </div>

    <!-- Modal Body: Tab 2 - Document Embed Preview -->
    <div id="modal-content-preview" class="hidden p-4 sm:p-5 overflow-y-auto flex-1 flex flex-col">
      <div class="relative w-full h-[320px] sm:h-[380px] rounded-xl overflow-hidden border border-[var(--color-border-washi)] bg-neutral-100 flex items-center justify-center">
        <iframe
          id="modal-preview-iframe"
          src=""
          class="w-full h-full border-0"
          loading="lazy"
          allow="autoplay"
        ></iframe>
        <div id="modal-preview-loading" class="absolute inset-0 flex flex-col items-center justify-center bg-[var(--color-surface)] text-xs text-[var(--color-ink-tertiary)] gap-2">
          <div class="w-6 h-6 border-2 border-[var(--color-vermilion)] border-t-transparent rounded-full animate-spin"></div>
          <span>Menghubungkan ke Google Drive Preview...</span>
        </div>
      </div>
      <p class="text-[11px] text-[var(--color-ink-tertiary)] text-center mt-2.5">
        Pratinjau dibatasi oleh Google Drive. Gunakan tombol "Buka di Google Drive" di bawah untuk akses halaman penuh & unduhan lengkap.
      </p>
    </div>

    <!-- Modal Footer Actions -->
    <div class="px-5 sm:px-6 py-3.5 bg-[var(--color-surface-subtle)] border-t border-[var(--color-border-washi)] flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 sm:gap-3">
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="modal-copy-btn"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3.5 py-2 min-h-[40px] rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-ink-primary)] active:scale-95 transition-all"
        >
          <Copy class="w-3.5 h-3.5" />
          <span id="copy-btn-text">Salin Link</span>
        </button>

        <a
          id="modal-permalink-btn"
          href="#"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3.5 py-2 min-h-[40px] rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] active:scale-95 transition-all"
          title="Buka Halaman Penuh Materi Ini"
        >
          <span>Halaman Penuh</span>
          <ArrowUpRight class="w-3.5 h-3.5" />
        </a>

        <button
          type="button"
          id="modal-report-btn"
          data-open-report
          data-report-id=""
          data-report-title=""
          class="inline-flex items-center justify-center p-2 min-h-[40px] rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-ink-tertiary)] hover:text-amber-600 transition-colors cursor-pointer"
          title="Laporkan jika link Google Drive ini bermasalah/mati"
        >
          <span class="text-xs">⚠️</span>
          <span class="hidden md:inline ml-1 text-[11px]">Lapor Link</span>
        </button>
      </div>

      <a
        id="modal-drive-btn"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-2 min-h-[40px] rounded-xl bg-[var(--color-vermilion)] hover:bg-[var(--color-vermilion-hover)] text-white text-xs font-bold shadow-2xs transition-all active:scale-95"
      >
        <span>Buka di Google Drive</span>
        <ExternalLink class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</div>
