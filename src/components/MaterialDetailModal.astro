---
import { X, ExternalLink, Copy, Check, BookOpen, Layers, Calendar, User, FileText } from '@lucide/astro';
---

<div
  id="detail-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/50 backdrop-blur-xs transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Modal Card -->
  <div class="relative w-full max-w-lg bg-[var(--color-surface)] border border-[var(--color-border-washi)] rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[90vh] animate-in fade-in zoom-in-95 duration-150">
    
    <!-- Modal Header -->
    <div class="px-6 pt-6 pb-4 border-b border-[var(--color-border-washi)] flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span id="modal-level-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold border">
            N5
          </span>
          <span id="modal-category-name" class="text-xs font-semibold text-[var(--color-vermilion)] uppercase tracking-wider">
            Tata Bahasa
          </span>
        </div>
        <h2 id="modal-title" class="text-lg sm:text-xl font-bold text-[var(--color-ink-primary)] leading-snug">
          Judul Buku
        </h2>
        <p id="modal-original-title" class="text-xs font-japanese text-[var(--color-ink-tertiary)] mt-0.5">
          みんなの日本語
        </p>
      </div>

      <!-- Close Button -->
      <button
        type="button"
        id="modal-close-btn"
        class="p-1.5 rounded-lg text-[var(--color-ink-tertiary)] hover:text-[var(--color-ink-primary)] hover:bg-[var(--color-surface-subtle)] transition-colors"
        aria-label="Tutup Detail"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="p-6 overflow-y-auto space-y-5 text-sm">
      <!-- Description -->
      <div>
        <h3 class="text-xs font-bold text-[var(--color-ink-tertiary)] uppercase tracking-wider mb-2">
          Deskripsi Materi
        </h3>
        <p id="modal-description" class="text-xs sm:text-sm text-[var(--color-ink-secondary)] leading-relaxed bg-[var(--color-canvas)] p-3.5 rounded-xl border border-[var(--color-border-washi)]">
          Deskripsi lengkap materi akan tampil di sini.
        </p>
      </div>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-2 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Pengarang</span>
          <span id="modal-author" class="font-semibold text-[var(--color-ink-primary)]">3A Corporation</span>
        </div>
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Penerbit</span>
          <span id="modal-publisher" class="font-semibold text-[var(--color-ink-primary)]">3A Corporation</span>
        </div>
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Tahun Terbit</span>
          <span id="modal-year" class="font-semibold text-[var(--color-ink-primary)]">2012</span>
        </div>
        <div class="p-3 rounded-xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)]">
          <span class="text-[11px] text-[var(--color-ink-tertiary)] block mb-0.5">Format & Ukuran</span>
          <span id="modal-size" class="font-semibold text-[var(--color-ink-primary)]">PDF (48 MB)</span>
        </div>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="px-6 py-4 bg-[var(--color-surface-subtle)] border-t border-[var(--color-border-washi)] flex items-center justify-between gap-3">
      <button
        type="button"
        id="modal-copy-btn"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-ink-primary)] transition-all"
      >
        <Copy class="w-3.5 h-3.5" />
        <span id="copy-btn-text">Salin Link</span>
      </button>

      <a
        id="modal-drive-btn"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[var(--color-vermilion)] hover:bg-[var(--color-vermilion-hover)] text-white text-xs font-bold shadow-2xs transition-all active:scale-95"
      >
        <span>Buka di Google Drive</span>
        <ExternalLink class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</div>
