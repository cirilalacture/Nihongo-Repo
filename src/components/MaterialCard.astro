---
import { ExternalLink, Info, Star, Bookmark, BookmarkCheck } from '@lucide/astro';

interface Material {
  id: string;
  title: string;
  romajiTitle: string | null;
  originalTitle: string | null;
  author: string | null;
  publisher: string | null;
  publishYear: number | null;
  description: string | null;
  driveUrl: string;
  driveFileId: string | null;
  coverImageUrl: string | null;
  fileType: string | null;
  fileSize: string | null;
  isRecommended: number | null;
  clickCount: number | null;
  categoryName?: string | null;
  categorySlug?: string | null;
  categoryIcon?: string | null;
  levelCode?: string | null;
  levelLabel?: string | null;
  badgeBg?: string | null;
  badgeText?: string | null;
}

interface Props {
  material: Material;
}

const { material } = Astro.props;

// Formatting Level Badge Style
const levelBg = material.badgeBg || '#F5F5F4';
const levelText = material.badgeText || '#44403C';
const levelCode = material.levelCode || 'ALL';
---

<article
  class="material-item group bg-[var(--color-surface)] border border-[var(--color-border-washi)] hover:border-neutral-300 rounded-2xl p-5 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between"
  data-id={material.id}
  data-title={material.title.toLowerCase()}
  data-romaji={material.romajiTitle ? material.romajiTitle.toLowerCase() : ''}
  data-original={material.originalTitle ? material.originalTitle.toLowerCase() : ''}
  data-author={material.author ? material.author.toLowerCase() : ''}
  data-level={levelCode}
  data-category={material.categorySlug || 'all'}
  data-file-type={material.fileType || 'PDF'}
>
  <div>
    <!-- Top Metadata: Clean typography, no boxy badges -->
    <div class="flex items-center justify-between gap-2 mb-3 text-xs">
      <!-- JLPT Level & Format as clean inline text -->
      <div class="flex items-center gap-1.5 min-w-0">
        <span class="font-bold text-[var(--color-ink-primary)]">
          {levelCode}
        </span>
        {material.levelLabel && levelCode !== 'ALL' && (
          <span class="text-[var(--color-ink-tertiary)] text-[11px] hidden sm:inline">
            {material.levelLabel.replace(levelCode, '').trim()}
          </span>
        )}
        <span class="text-[var(--color-ink-tertiary)] opacity-40">•</span>
        <span class="text-[var(--color-ink-secondary)] text-[11px]">
          {material.fileType === 'AUDIO_ZIP' ? 'Audio' : material.fileType === 'ANKI' ? 'Anki' : material.fileType === 'EXCEL' ? 'Sheet' : 'PDF'}
        </span>
      </div>

      <!-- Actions & Star -->
      <div class="flex items-center gap-2 shrink-0">
        {material.isRecommended === 1 && (
          <span class="inline-flex items-center gap-1 text-[11px] font-medium text-amber-600 dark:text-amber-400" title="Rekomendasi Utama">
            <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
            <span class="hidden sm:inline">Pilihan</span>
          </span>
        )}
        <button
          type="button"
          class="btn-bookmark p-1.5 rounded-lg border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-[var(--color-ink-tertiary)] hover:text-red-500 hover:border-red-300 active:scale-90 transition-all cursor-pointer"
          data-id={material.id}
          title="Simpan ke Favorit"
          aria-label="Simpan ke Favorit"
        >
          <Bookmark class="w-3.5 h-3.5 bookmark-empty" />
          <BookmarkCheck class="w-3.5 h-3.5 bookmark-filled text-[var(--color-vermilion)] hidden" />
        </button>
      </div>
    </div>

    <!-- Cover Image / Aesthetic Kanji Banner Placeholder -->
    <div class="relative w-full h-40 mb-4 rounded-xl overflow-hidden bg-neutral-100 border border-[var(--color-border-washi)] flex items-center justify-center group-hover:scale-[1.01] transition-transform duration-300">
      {material.coverImageUrl ? (
        <img
          src={material.coverImageUrl}
          alt={material.title}
          loading="lazy"
          class="w-full h-full object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      ) : null}
      <div
        class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-red-50/50 via-neutral-100 to-amber-50/40 p-4 text-center"
        style={material.coverImageUrl ? 'display: none;' : 'display: flex;'}
      >
        <div class="text-3xl font-bold font-japanese text-[var(--color-ink-primary)]/80 mb-1">
          {material.originalTitle ? material.originalTitle.slice(0, 4) : '日本語'}
        </div>
        <span class="text-[11px] text-[var(--color-ink-tertiary)] font-medium max-w-[180px] truncate">
          {material.title}
        </span>
      </div>
    </div>

    <!-- Category Label -->
    {material.categoryName && (
      <div class="text-[11px] font-semibold text-[var(--color-vermilion)] uppercase tracking-wider mb-1 flex items-center gap-1">
        <span>{material.categoryName}</span>
      </div>
    )}

    <!-- Titles -->
    <h3 class="text-base font-bold text-[var(--color-ink-primary)] tracking-tight leading-snug mb-1 group-hover:text-[var(--color-vermilion)] transition-colors line-clamp-2">
      <a href={`/materi/${material.id}`} class="hover:underline" title={`Buka halaman detail: ${material.title}`}>
        {material.title}
      </a>
    </h3>

    {material.originalTitle && (
      <p class="text-xs font-japanese text-[var(--color-ink-tertiary)] mb-2 line-clamp-1">
        {material.originalTitle}
      </p>
    )}

    <!-- Description -->
    {material.description && (
      <p class="text-xs text-[var(--color-ink-secondary)] leading-relaxed mb-4 line-clamp-2">
        {material.description}
      </p>
    )}
  </div>

  <!-- Bottom Section: Metadata & Action Buttons -->
  <div class="pt-3 border-t border-[var(--color-border-washi)] mt-2">
    <!-- Meta: Author, Year & Size -->
    <div class="flex items-center justify-between text-[11px] text-[var(--color-ink-tertiary)] mb-3">
      <span class="truncate max-w-[150px]">
        {material.author || 'Penerbit Standar'}
      </span>
      <span>{material.fileSize || 'PDF'}</span>
    </div>

    <!-- Action Buttons -->
    <div class="grid grid-cols-2 gap-2">
      <!-- Detail Modal Trigger -->
      <button
        type="button"
        class="btn-open-detail w-full flex items-center justify-center gap-1.5 py-2.5 px-3 min-h-[42px] sm:min-h-0 rounded-xl border border-[var(--color-border-washi)] hover:bg-[var(--color-surface-subtle)] text-xs font-semibold text-[var(--color-ink-secondary)] active:scale-95 transition-all"
        data-id={material.id}
      >
        <Info class="w-3.5 h-3.5" />
        <span>Detail</span>
      </button>

      <!-- Direct Google Drive Button -->
      <a
        href={material.driveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-1.5 py-2.5 px-3 min-h-[42px] sm:min-h-0 rounded-xl bg-[var(--color-vermilion)] hover:bg-[var(--color-vermilion-hover)] text-white text-xs font-bold shadow-2xs transition-all duration-150 active:scale-95"
        title="Buka file langsung di Google Drive"
      >
        <span>Buka Drive</span>
        <ExternalLink class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</article>
