---
import { Search, BookOpen, Layers, Award, Menu, X, Sun, Moon, User, ALargeSmall } from '@lucide/astro';
---

<header class="border-b border-[var(--color-border-washi)] bg-[var(--color-canvas)]/95 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="w-9 h-9 rounded-lg bg-[var(--color-vermilion)] text-white flex items-center justify-center font-bold text-lg shadow-sm shadow-red-500/20 group-hover:scale-105 transition-transform duration-200">
        日
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-base sm:text-lg tracking-tight text-[var(--color-ink-primary)] leading-none">
            Nihongo_repo
          </span>
          <span class="text-xs font-japanese font-medium text-[var(--color-ink-tertiary)] ml-0.5">
            日本語
          </span>
        </div>
        <span class="text-[11px] text-[var(--color-ink-tertiary)] font-medium leading-tight hidden xs:block">
          Repository Belajar Bahasa Jepang
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop & Tablet Landscape) -->
    <nav class="hidden md:flex items-center gap-3.5 lg:gap-6 text-xs lg:text-sm font-medium text-[var(--color-ink-secondary)]">
      <a href="/#katalog" class="hover:text-[var(--color-vermilion)] transition-colors py-1">Semua Buku</a>
      <a href="/#jlpt-filter" class="hover:text-[var(--color-vermilion)] transition-colors py-1">Level JLPT</a>
      <a href="/#kategori" class="hover:text-[var(--color-vermilion)] transition-colors py-1">Kategori</a>
      <a href="/about" class="hover:text-[var(--color-vermilion)] transition-colors py-1">Tentang</a>
      <button
        type="button"
        data-open-request
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold text-[var(--color-vermilion)] bg-red-50/80 dark:bg-red-950/40 border border-red-200/80 dark:border-red-900/50 hover:bg-red-100/70 transition-all cursor-pointer"
        title="Ajukan permintaan buku baru atau lapor link bermasalah"
      >
        <span>Request Buku</span>
      </button>
    </nav>

    <!-- Actions: Search, Theme Toggle, Admin Link & Mobile Hamburger -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Search Shortcut Trigger -->
      <a
        href="/#pencarian"
        class="flex items-center gap-2 px-2.5 sm:px-3 py-1.5 min-h-[38px] rounded-lg border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-xs text-[var(--color-ink-secondary)] hover:border-neutral-300 transition-colors shadow-2xs active:scale-95"
        aria-label="Pencarian materi"
      >
        <Search class="w-3.5 h-3.5 text-[var(--color-ink-tertiary)]" />
        <span class="hidden lg:inline">Cari materi...</span>
        <kbd class="hidden xl:inline-block px-1.5 py-0.5 text-[10px] font-mono text-[var(--color-ink-tertiary)] bg-neutral-100 rounded border border-neutral-200">
          /
        </kbd>
      </a>

      <!-- Theme Switcher Toggle (Washi Day / Sumi Night) -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] active:scale-90 transition-all cursor-pointer"
        title="Ganti Tema (Washi Terang / Sumi Gelap)"
        aria-label="Ganti Tema"
      >
        <Sun class="w-4 h-4 theme-icon-sun hidden" />
        <Moon class="w-4 h-4 theme-icon-moon" />
      </button>

      <!-- Accessibility Font & Size Settings Popover Trigger -->
      <div class="relative hidden sm:block" id="font-settings-container">
        <button
          type="button"
          id="font-settings-btn"
          class="flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] active:scale-90 transition-all cursor-pointer group"
          title="Pengaturan Ukuran & Jenis Font (Aksesibilitas)"
          aria-label="Pengaturan Ukuran dan Jenis Font Aksesibilitas"
          aria-expanded="false"
          aria-controls="font-settings-dropdown"
        >
          <ALargeSmall class="w-4 h-4 transition-transform group-hover:scale-105" />
        </button>

        <!-- Floating Popover Dropdown Panel (Desktop) -->
        <div
          id="font-settings-dropdown"
          class="hidden absolute right-0 top-full mt-2 w-72 sm:w-80 bg-[var(--color-surface)] border border-[var(--color-border-washi)] rounded-2xl shadow-xl p-4 z-50 text-xs"
          role="region"
          aria-label="Pengaturan Font dan Ukuran Teks"
        >
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-[var(--color-border-washi)]">
            <div class="flex items-center gap-2">
              <ALargeSmall class="w-4 h-4 text-[var(--color-vermilion)]" />
              <span class="font-bold text-[var(--color-ink-primary)] text-xs">Aksesibilitas Teks</span>
            </div>
            <span id="font-scale-current-badge" class="px-2 py-0.5 rounded-md bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)] text-[10px] font-mono text-[var(--color-ink-tertiary)]">
              100%
            </span>
          </div>

          <!-- Section 1: Font Size Steppers -->
          <div class="space-y-2 mb-4">
            <div class="flex items-center justify-between text-[11px] font-semibold text-[var(--color-ink-tertiary)]">
              <span>Ukuran Teks</span>
              <button
                type="button"
                id="font-scale-reset-btn"
                class="text-[10px] text-[var(--color-vermilion)] hover:underline cursor-pointer"
              >
                Reset Normal
              </button>
            </div>
            <div class="grid grid-cols-4 gap-1.5 p-1 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-washi)]">
              <button
                type="button"
                data-scale="90"
                class="font-scale-btn py-1.5 px-2 rounded-lg text-center font-bold transition-all text-xs cursor-pointer hover:bg-[var(--color-surface)]"
                title="Kecil (90%)"
              >
                A-
              </button>
              <button
                type="button"
                data-scale="100"
                class="font-scale-btn py-1.5 px-2 rounded-lg text-center font-bold transition-all text-xs cursor-pointer bg-[var(--color-surface)] text-[var(--color-vermilion)] shadow-2xs"
                title="Normal (100%)"
              >
                A
              </button>
              <button
                type="button"
                data-scale="112"
                class="font-scale-btn py-1.5 px-2 rounded-lg text-center font-bold transition-all text-xs cursor-pointer hover:bg-[var(--color-surface)]"
                title="Besar (112%)"
              >
                A+
              </button>
              <button
                type="button"
                data-scale="125"
                class="font-scale-btn py-1.5 px-2 rounded-lg text-center font-bold transition-all text-xs cursor-pointer hover:bg-[var(--color-surface)]"
                title="Ekstra Besar (125%)"
              >
                A++
              </button>
            </div>
          </div>

          <!-- Section 2: Font Family Options -->
          <div class="space-y-2">
            <div class="text-[11px] font-semibold text-[var(--color-ink-tertiary)]">
              Pilihan Jenis Huruf (Font)
            </div>
            <div class="space-y-1.5">
              <button
                type="button"
                data-font="gothic"
                class="font-family-btn w-full flex items-center justify-between p-2 rounded-xl border transition-all text-left cursor-pointer border-[var(--color-vermilion)] bg-red-50/50 dark:bg-red-950/30 text-[var(--color-vermilion)]"
              >
                <div>
                  <span class="font-bold text-xs block text-[var(--color-ink-primary)]">Gothic Modern</span>
                  <span class="text-[10px] text-[var(--color-ink-tertiary)]">Noto Sans JP (Standar Digital)</span>
                </div>
                <span class="font-japanese text-sm font-semibold">あア</span>
              </button>

              <button
                type="button"
                data-font="mincho"
                class="font-family-btn w-full flex items-center justify-between p-2 rounded-xl border border-[var(--color-border-washi)] hover:border-neutral-300 dark:hover:border-neutral-600 transition-all text-left cursor-pointer"
              >
                <div>
                  <span class="font-bold text-xs block text-[var(--color-ink-primary)] font-serif">Mincho Sastra</span>
                  <span class="text-[10px] text-[var(--color-ink-tertiary)]">Noto Serif JP (Buku Novel)</span>
                </div>
                <span class="font-serif text-sm font-semibold">あア</span>
              </button>

              <button
                type="button"
                data-font="klee"
                class="font-family-btn w-full flex items-center justify-between p-2 rounded-xl border border-[var(--color-border-washi)] hover:border-neutral-300 dark:hover:border-neutral-600 transition-all text-left cursor-pointer"
              >
                <div>
                  <span class="font-bold text-xs block text-[var(--color-ink-primary)]">Klee Buku Teks</span>
                  <span class="text-[10px] text-[var(--color-ink-tertiary)]">Klee One (Gaya Pensil Sekolah)</span>
                </div>
                <span class="text-sm font-semibold" style="font-family: 'Klee One', cursive, sans-serif;">あア</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl border border-[var(--color-border-washi)] bg-[var(--color-surface)] text-[var(--color-ink-secondary)] hover:text-[var(--color-ink-primary)] active:scale-95 transition-all"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <Menu id="mobile-menu-open-icon" class="w-5 h-5" />
        <X id="mobile-menu-close-icon" class="w-5 h-5 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden border-t border-[var(--color-border-washi)] bg-[var(--color-surface)] px-4 py-4 space-y-2 shadow-lg animate-in slide-in-from-top-2 duration-150"
  >
    <div class="space-y-1">
      <a
        href="/#katalog"
        class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] hover:bg-[var(--color-surface-subtle)] transition-colors"
      >
        <BookOpen class="w-4 h-4 text-[var(--color-ink-tertiary)]" />
        <span>Semua Buku & Materi</span>
      </a>

      <a
        href="/#jlpt-filter"
        class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] hover:bg-[var(--color-surface-subtle)] transition-colors"
      >
        <Award class="w-4 h-4 text-[var(--color-ink-tertiary)]" />
        <span>Level JLPT (N5 - N1)</span>
      </a>

      <a
        href="/#kategori"
        class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] hover:bg-[var(--color-surface-subtle)] transition-colors"
      >
        <Layers class="w-4 h-4 text-[var(--color-ink-tertiary)]" />
        <span>Kategori Topik</span>
      </a>

      <a
        href="/about"
        class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-[var(--color-ink-secondary)] hover:text-[var(--color-vermilion)] hover:bg-[var(--color-surface-subtle)] transition-colors"
      >
        <User class="w-4 h-4 text-[var(--color-ink-tertiary)]" />
        <span>Tentang Pembuat</span>
      </a>

      <button
        type="button"
        data-open-request
        class="mobile-nav-link w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-[var(--color-vermilion)] hover:bg-red-50/60 dark:hover:bg-red-950/40 transition-colors cursor-pointer"
      >
        <span class="text-sm">📝</span>
        <span>Request Buku / Lapor Link</span>
      </button>
    </div>

    <div class="pt-2 border-t border-[var(--color-border-washi)]">
      <!-- Mobile Theme Switcher Row -->
      <button
        type="button"
        id="mobile-theme-toggle-btn"
        class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold bg-[var(--color-surface-subtle)] text-[var(--color-ink-secondary)] hover:text-[var(--color-ink-primary)] border border-[var(--color-border-washi)] transition-colors"
      >
        <span class="flex items-center gap-3">
          <Sun class="w-4 h-4 theme-icon-sun hidden text-amber-500" />
          <Moon class="w-4 h-4 theme-icon-moon text-[var(--color-ink-tertiary)]" />
          <span>Mode Tampilan</span>
        </span>
        <span id="mobile-theme-label" class="text-xs font-bold text-[var(--color-ink-tertiary)]">Terang</span>
      </button>

      <!-- Mobile Accessibility Settings (Ukuran Teks & Pilihan Font) -->
      <div class="pt-3 border-t border-[var(--color-border-washi)] space-y-3">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-[var(--color-ink-primary)] flex items-center gap-1.5">
            <ALargeSmall class="w-4 h-4 text-[var(--color-vermilion)]" />
            <span>Ukuran Teks</span>
          </span>
          <span id="mobile-font-scale-badge" class="px-2 py-0.5 rounded-md bg-[var(--color-surface-subtle)] border border-[var(--color-border-washi)] text-[10px] font-mono text-[var(--color-ink-tertiary)]">
            100%
          </span>
        </div>

        <!-- Mobile Size Stepper -->
        <div class="grid grid-cols-4 gap-1.5 p-1 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-washi)] text-xs">
          <button type="button" data-scale="90" class="mobile-font-scale-btn py-2 rounded-lg font-bold text-center transition-all cursor-pointer">A-</button>
          <button type="button" data-scale="100" class="mobile-font-scale-btn py-2 rounded-lg font-bold text-center transition-all cursor-pointer bg-[var(--color-surface)] text-[var(--color-vermilion)] shadow-2xs">A</button>
          <button type="button" data-scale="112" class="mobile-font-scale-btn py-2 rounded-lg font-bold text-center transition-all cursor-pointer">A+</button>
          <button type="button" data-scale="125" class="mobile-font-scale-btn py-2 rounded-lg font-bold text-center transition-all cursor-pointer">A++</button>
        </div>

        <div class="text-xs font-bold text-[var(--color-ink-primary)] pt-1">
          Pilihan Font
        </div>

        <!-- Mobile Font Family Picker -->
        <div class="grid grid-cols-3 gap-1.5 text-xs">
          <button
            type="button"
            data-font="gothic"
            class="mobile-font-family-btn py-2 px-1 rounded-xl border transition-all text-center font-bold cursor-pointer border-[var(--color-vermilion)] bg-red-50/50 dark:bg-red-950/30 text-[var(--color-vermilion)]"
          >
            <span class="block">Gothic</span>
            <span class="text-[10px] opacity-75 font-normal block">Noto Sans</span>
          </button>
          <button
            type="button"
            data-font="mincho"
            class="mobile-font-family-btn py-2 px-1 rounded-xl border border-[var(--color-border-washi)] transition-all text-center font-bold font-serif cursor-pointer hover:bg-[var(--color-surface-subtle)]"
          >
            <span class="block">Mincho</span>
            <span class="text-[10px] opacity-75 font-normal block font-serif">Serif</span>
          </button>
          <button
            type="button"
            data-font="klee"
            class="mobile-font-family-btn py-2 px-1 rounded-xl border border-[var(--color-border-washi)] transition-all text-center font-bold cursor-pointer hover:bg-[var(--color-surface-subtle)]"
            style="font-family: 'Klee One', cursive, sans-serif;"
          >
            <span class="block">Klee</span>
            <span class="text-[10px] opacity-75 font-normal block">Tulisan</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    // 1. Mobile Menu Drawer Toggle
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const menuEl = document.getElementById('mobile-nav-menu');
    const openIcon = document.getElementById('mobile-menu-open-icon');
    const closeIcon = document.getElementById('mobile-menu-close-icon');

    if (toggleBtn && menuEl) {
      function toggleMenu() {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        if (isExpanded) {
          menuEl.classList.add('hidden');
          if (openIcon) openIcon.classList.remove('hidden');
          if (closeIcon) closeIcon.classList.add('hidden');
        } else {
          menuEl.classList.remove('hidden');
          if (openIcon) openIcon.classList.add('hidden');
          if (closeIcon) closeIcon.classList.remove('hidden');
        }
      }

      toggleBtn.addEventListener('click', toggleMenu);

      const navLinks = menuEl.querySelectorAll('.mobile-nav-link');
      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (!menuEl.classList.contains('hidden')) {
            toggleMenu();
          }
        });
      });
    }

    // 2. Dark Mode Switcher Controller
    const themeBtn = document.getElementById('theme-toggle-btn');
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle-btn');
    const mobileThemeLabel = document.getElementById('mobile-theme-label');

    function syncThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('.theme-icon-sun').forEach((el) => {
        if (isDark) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
      document.querySelectorAll('.theme-icon-moon').forEach((el) => {
        if (isDark) el.classList.add('hidden');
        else el.classList.remove('hidden');
      });
      if (mobileThemeLabel) {
        mobileThemeLabel.textContent = isDark ? 'Sumi Gelap' : 'Washi Terang';
      }
    }

    function toggleDarkMode() {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('nihongo_theme', isDark ? 'dark' : 'light');
      } catch (e) {}
      syncThemeIcons();
    }

    if (themeBtn) themeBtn.addEventListener('click', toggleDarkMode);
    if (mobileThemeBtn) mobileThemeBtn.addEventListener('click', toggleDarkMode);

    syncThemeIcons();

    // 3. Accessibility Typography (Font Size & Font Family) Controller
    const fontBtn = document.getElementById('font-settings-btn');
    const fontDropdown = document.getElementById('font-settings-dropdown');
    const fontContainer = document.getElementById('font-settings-container');
    const resetScaleBtn = document.getElementById('font-scale-reset-btn');
    const scaleBadge = document.getElementById('font-scale-current-badge');
    const mobileScaleBadge = document.getElementById('mobile-font-scale-badge');

    if (fontBtn && fontDropdown) {
      fontBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = fontDropdown.classList.contains('hidden');
        if (isHidden) {
          fontDropdown.classList.remove('hidden');
          fontBtn.setAttribute('aria-expanded', 'true');
        } else {
          fontDropdown.classList.add('hidden');
          fontBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (fontContainer && !fontContainer.contains(e.target)) {
          fontDropdown.classList.add('hidden');
          fontBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !fontDropdown.classList.contains('hidden')) {
          fontDropdown.classList.add('hidden');
          fontBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Apply & Sync Font Scale
    function applyFontScale(scale) {
      document.documentElement.style.fontSize = scale === '100' ? '' : scale + '%';
      try {
        localStorage.setItem('nihongo_font_scale', scale);
      } catch (e) {}

      if (scaleBadge) scaleBadge.textContent = scale + '%';
      if (mobileScaleBadge) mobileScaleBadge.textContent = scale + '%';

      // Desktop buttons
      document.querySelectorAll('.font-scale-btn').forEach((btn) => {
        const btnScale = btn.getAttribute('data-scale');
        if (btnScale === scale) {
          btn.classList.add('bg-[var(--color-surface)]', 'text-[var(--color-vermilion)]', 'shadow-2xs');
          btn.classList.remove('hover:bg-[var(--color-surface)]');
        } else {
          btn.classList.remove('bg-[var(--color-surface)]', 'text-[var(--color-vermilion)]', 'shadow-2xs');
          btn.classList.add('hover:bg-[var(--color-surface)]');
        }
      });

      // Mobile buttons
      document.querySelectorAll('.mobile-font-scale-btn').forEach((btn) => {
        const btnScale = btn.getAttribute('data-scale');
        if (btnScale === scale) {
          btn.classList.add('bg-[var(--color-surface)]', 'text-[var(--color-vermilion)]', 'shadow-2xs');
        } else {
          btn.classList.remove('bg-[var(--color-surface)]', 'text-[var(--color-vermilion)]', 'shadow-2xs');
        }
      });
    }

    // Apply & Sync Font Family
    function applyFontFamily(font) {
      document.documentElement.setAttribute('data-font', font);
      try {
        localStorage.setItem('nihongo_font_family', font);
      } catch (e) {}

      // Desktop buttons
      document.querySelectorAll('.font-family-btn').forEach((btn) => {
        const btnFont = btn.getAttribute('data-font');
        if (btnFont === font) {
          btn.classList.add('border-[var(--color-vermilion)]', 'bg-red-50/50', 'dark:bg-red-950/30', 'text-[var(--color-vermilion)]');
          btn.classList.remove('border-[var(--color-border-washi)]');
        } else {
          btn.classList.remove('border-[var(--color-vermilion)]', 'bg-red-50/50', 'dark:bg-red-950/30', 'text-[var(--color-vermilion)]');
          btn.classList.add('border-[var(--color-border-washi)]');
        }
      });

      // Mobile buttons
      document.querySelectorAll('.mobile-font-family-btn').forEach((btn) => {
        const btnFont = btn.getAttribute('data-font');
        if (btnFont === font) {
          btn.classList.add('border-[var(--color-vermilion)]', 'bg-red-50/50', 'dark:bg-red-950/30', 'text-[var(--color-vermilion)]');
          btn.classList.remove('border-[var(--color-border-washi)]');
        } else {
          btn.classList.remove('border-[var(--color-vermilion)]', 'bg-red-50/50', 'dark:bg-red-950/30', 'text-[var(--color-vermilion)]');
          btn.classList.add('border-[var(--color-border-washi)]');
        }
      });
    }

    // Event listeners
    document.querySelectorAll('[data-scale]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const scale = btn.getAttribute('data-scale');
        if (scale) applyFontScale(scale);
      });
    });

    if (resetScaleBtn) {
      resetScaleBtn.addEventListener('click', () => applyFontScale('100'));
    }

    document.querySelectorAll('[data-font]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const font = btn.getAttribute('data-font');
        if (font) applyFontFamily(font);
      });
    });

    // Initial state
    try {
      const initialScale = localStorage.getItem('nihongo_font_scale') || '100';
      const initialFont = localStorage.getItem('nihongo_font_family') || 'gothic';
      applyFontScale(initialScale);
      applyFontFamily(initialFont);
    } catch (e) {}
  })();
</script>
