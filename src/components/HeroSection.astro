---
import { BookOpen, Sparkles, FolderDown, ArrowDown } from '@lucide/astro';

interface Props {
  totalMaterials?: number;
  totalCategories?: number;
}

const { totalMaterials = 9, totalCategories = 6 } = Astro.props;
---

<section class="relative pt-12 pb-14 md:pt-16 md:pb-20 overflow-hidden border-b border-[var(--color-border-washi)]">
  <!-- Subtle Japanese Pattern Background / Torii Mist Glow -->
  <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center opacity-[0.03]">
    <span class="text-[280px] font-bold select-none text-[var(--color-ink-primary)] font-serif leading-none">
      日本
    </span>
  </div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-red-500/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 text-center">
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-surface)] border border-[var(--color-border-washi)] text-[11px] sm:text-xs font-medium text-[var(--color-ink-secondary)] mb-6 shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
      <span class="font-japanese text-[var(--color-ink-tertiary)] hidden sm:inline">日本語学習資料</span>
      <span class="text-neutral-300 hidden sm:inline">|</span>
      <span>Cloudflare Pages & D1 Live</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-2xl xs:text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[var(--color-ink-primary)] leading-[1.2] sm:leading-[1.15] mb-4 sm:mb-5">
      Koleksi Terkurasi Materi & Buku <br class="hidden sm:inline" />
      <span class="text-[var(--color-vermilion)] relative inline-block">
        Bahasa Jepang
        <svg class="absolute -bottom-1 left-0 w-full h-2 text-red-300/60 -z-10" viewBox="0 0 100 20" preserveAspectRatio="none">
          <path d="M0,15 Q50,0 100,15" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
        </svg>
      </span>
    </h1>

    <!-- Descriptive Subtitle -->
    <p class="text-sm sm:text-base md:text-lg text-[var(--color-ink-secondary)] max-w-2xl mx-auto mb-6 sm:mb-8 leading-relaxed font-normal">
      Katalog terpusat untuk mencari buku teks, tata bahasa, kanji, audio pemahaman, dan persiapan ujian JLPT N5 hingga N1 yang tersimpan aman di Google Drive.
    </p>

    <!-- Key Metrics Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs text-[var(--color-ink-secondary)] mb-6 sm:mb-8">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border-washi)] shadow-2xs">
        <BookOpen class="w-3.5 h-3.5 text-[var(--color-vermilion)]" />
        <span><strong>{totalMaterials}</strong> Materi Terdaftar</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border-washi)] shadow-2xs">
        <Sparkles class="w-3.5 h-3.5 text-amber-500" />
        <span><strong>{totalCategories}</strong> Kategori Topik</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border-washi)] shadow-2xs">
        <FolderDown class="w-3.5 h-3.5 text-emerald-600" />
        <span>Akses Google Drive Langsung</span>
      </div>
    </div>

    <!-- Quick Action Button -->
    <div class="flex justify-center">
      <a
        href="/#katalog"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] rounded-xl bg-neutral-900 hover:bg-neutral-800 text-white dark:bg-neutral-100 dark:hover:bg-white dark:text-neutral-950 font-semibold text-sm shadow-sm transition-all duration-200 active:scale-95 group"
      >
        <span>Jelajahi Repository</span>
        <ArrowDown class="w-4 h-4 text-neutral-400 dark:text-neutral-600 group-hover:translate-y-0.5 transition-transform" />
      </a>
    </div>
  </div>
</section>
