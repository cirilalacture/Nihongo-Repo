{
  "name": "nihongo_repo",
  "type": "module",
  "version": "0.1.0",
  "description": "Repository materi dan buku belajar bahasa Jepang terkurasi di Cloudflare Pages & D1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute nihongo-repo-db --local --file=./schema.sql",
    "db:migrate:prod": "wrangler d1 execute nihongo-repo-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@lucide/astro": "^1.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "drizzle-orm": "^0.45.4",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.158.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
